{
    // You can comment here,
    config: {
        // here
        bot_name: "Athena",
        // or here
        bot_id: "22354373457231251362",
        // and even here
        // 
        //
        //
        // or here :)
        bot: true,
        

        // Permission configuration. The following configuration works exactly like the
        // permission configuration in your permission config file. All permission levels
        // that are available over there can be used here.
        permissions: {
            test_command: 'everyone',
            info_command: 'member',
            ticket_inactivity_event: 'everyone',
        },

        // Array of objects example (dashboard type 1000)
        dashboard_panels: [{
            name: 'Welcome',
            channel_id: '000000000000000000',
            enabled: true,
            tags: ['intro', 'rules']
        }],

        // Dynamic object map with schema example (dashboard type 1001)
        alert_rules: {
            raid_protection: [{
                role_id: '000000000000000000',
                threshold: 5,
                enabled: true,
                notes: ['Auto lock enabled']
            }]
        },
    }
}